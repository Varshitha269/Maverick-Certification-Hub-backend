# App
APP_NAME="Maverick Certification Hub"
ENVIRONMENT="dev"
API_BASE_URL="http://127.0.0.1:8000"
FRONTEND_BASE_URL="http://127.0.0.1:3000"

# Security
JWT_SECRET="7c2cc3691f3a204eec2909b69871f2a6a2463f1702b338aeac0d0799ede386f2"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL="sqlite:///./backend.db"

# Admin bootstrap (created on first startup if not exists)
BOOTSTRAP_ADMIN_EMAIL="varshithagovindaswamy@gmail.com"
BOOTSTRAP_ADMIN_PASSWORD="Admin@12345"

# SendGrid
SENDGRID_API_KEY=""
EMAIL_FROM="no-reply@maverick.local"

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="certifications"

# Azure OpenAI (optional; endpoints still work with mock mode off)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"
AI_ENABLED=false

# Scheduler
REMINDER_JOB_INTERVAL_MINUTES=60
OVERDUE_AFTER_DAYS=14
