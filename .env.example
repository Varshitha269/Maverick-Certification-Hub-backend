# App
APP_NAME="Maverick Certification Hub"
ENVIRONMENT="dev"
API_BASE_URL="http://127.0.0.1:8000"
FRONTEND_BASE_URL="http://127.0.0.1:3000"

# Security
JWT_SECRET="change-me"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
# Local:
DATABASE_URL="sqlite:///./backend.db"
# Azure PostgreSQL (replace USER/PASSWORD/HOST/DBNAME; URL-encode special chars in password; use sslmode=require):
# DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@HOST.postgres.database.azure.com:5432/DBNAME?sslmode=require"

# Admin bootstrap (created on first startup if not exists)
BOOTSTRAP_ADMIN_EMAIL="admin@maverick.local"
BOOTSTRAP_ADMIN_PASSWORD="Admin@12345"

# Azure Communication Services — Email
# Copy connection string from ACS resource → Keys. Use MailFrom from your linked Email Communication domain.
ACS_EMAIL_CONNECTION_STRING=""
EMAIL_FROM="DoNotReply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net"

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="certifications"

# AI provider: azure_openai | ollama
AI_ENABLED=false
AI_PROVIDER="azure_openai"
AI_REQUEST_TIMEOUT_SECONDS=60

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_DEPLOYMENT="gpt-4o-mini"

# Ollama local runtime
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1:8b"

# Scheduler
REMINDER_JOB_INTERVAL_MINUTES=60
OVERDUE_AFTER_DAYS=14
